    "react-dom": "^19.3.1",
    "viem": "^2.57.7",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
