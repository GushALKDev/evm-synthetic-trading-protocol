  "version": "0.1.0",
  "type": "module",
  "description": "Demo app for the EVM synthetic trading protocol on Base Sepolia",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
